# Build output
/dist/
/coverage.out
/coverage.html

# The dashboard's build output. The directory itself is tracked, via the
# .gitkeep, because internal/web embeds it and the Go build must work
# whether or not the dashboard has been built.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Dashboard dependencies and incremental build state
/web/node_modules/
*.tsbuildinfo

# The landing site. Unlike the dashboard, nothing embeds its output, so the
# whole directory is build artifact.
/site/node_modules/
/site/dist/

# Local configuration and runner state
/.runnerly/
*.local.yaml

# Editors
.idea/
.vscode/
*.swp

# macOS
.DS_Store
