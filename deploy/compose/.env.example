# Copy to .env and fill in. Compose refuses to start without POSTGRES_PASSWORD
# rather than defaulting to something guessable.

POSTGRES_PASSWORD=

# Encrypts signed-in users' GitHub tokens at rest.
# Generate with: runnerly server keygen
RUNNERLY_SECRET_KEY=

# A GitHub OAuth App belongs to whoever runs this server, so Runnerly ships
# none. Until these are set, dashboard sign-in is disabled and the server says
# what is missing. Callback URL: https://<your-host>/api/v1/auth/github/callback
RUNNERLY_OAUTH_CLIENT_ID=
RUNNERLY_OAUTH_CLIENT_SECRET=
